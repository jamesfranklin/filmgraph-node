{
  "name": "filmgraph-node",
  "version": "0.1.0",
  "description": "FilmGraph node template: Hono over SQLite-shaped storage (Cloudflare D1, libSQL, a file), REST + MCP, conformant to the FilmGraph node contract; runs on Workers, Node or Deno",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:init": "tsx scripts/db-init.ts",
    "db:init:remote": "tsx scripts/db-init.ts --remote",
    "load": "tsx scripts/load.ts",
    "from-sheet": "tsx scripts/from-sheet.ts",
    "issue-key": "tsx scripts/issue-key.ts",
    "start": "tsx src/entry-node.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@libsql/client": "^0.15.15",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
